# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/ello_booth

# ---- Secrets ----
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ---- Platform Gemini key ----
# Used only for tenants on keyMode "platform". BYOK tenants never touch this.
PLATFORM_GEMINI_KEY=

# ---- Storage ----
STORAGE_DIR=./storage

# ---- Seed (first run only) ----
SUPERADMIN_EMAIL=admin@elloindia.com
SUPERADMIN_PASSWORD=change-me-now

# ---- Face service ----
# Local Python service that puts the visitor's real face into the photo.
# See face-service/README.md. Unset means the swap is skipped entirely.
FACE_SERVICE_URL=http://127.0.0.1:8000
